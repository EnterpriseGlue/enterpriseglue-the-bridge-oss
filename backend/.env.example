# =============================================================================
# EnterpriseGlue Backend Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# Server Configuration
API_PORT=8787

# =============================================================================
# Database Configuration
# =============================================================================
# Supported: postgres, oracle, mssql, spanner, mysql
DATABASE_TYPE=postgres

# =============================================================================
# PostgreSQL Configuration (when DATABASE_TYPE=postgres)
# =============================================================================
# Works with: PostgreSQL, Amazon RDS for PostgreSQL, Amazon Aurora PostgreSQL
#
# Option A: connection string (recommended for managed/external/multi-host DBs)
# Supports standard PostgreSQL URL format including sslmode query param.
# When set, individual vars below (POSTGRES_HOST etc.) are not required.
# POSTGRES_URL=postgresql://user:password@host:5432/enterpriseglue?schema=main&sslmode=require

# Option B: individual variables
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DATABASE=postgres
POSTGRES_SCHEMA=main
POSTGRES_SSL=true
# Required. Controls TLS certificate verification for PostgreSQL connections.
# - 'true'  = verify the server certificate (recommended for production)
# - 'false' = skip certificate verification (encrypted but no identity check)
# If set to 'true' and connecting to Cloud SQL / self-signed certs, you must
# provide the CA certificate via NODE_EXTRA_CA_CERTS (see below).
POSTGRES_SSL_REJECT_UNAUTHORIZED=true

# Path to a PEM file containing the CA certificate for your database server.
# Required when POSTGRES_SSL_REJECT_UNAUTHORIZED=true and the CA is not in your
# system trust store.
#
# For Google Cloud SQL:
#   gcloud sql instances describe <INSTANCE> --format="value(serverCaCert.cert)" > server-ca.pem
#
# For other providers: download the CA bundle from your provider's docs.
#
# Alternatively, on Node 22+ you can use NODE_OPTIONS="--use-system-ca" if the
# CA is already in your OS trust store (e.g. macOS Keychain).
# NODE_EXTRA_CA_CERTS=./server-ca.pem

# =============================================================================
# Oracle Configuration (when DATABASE_TYPE=oracle)
# =============================================================================
# Option A: connection string — required for multi-host HA/failover setups.
# Supports Oracle Easy Connect Plus and full TNS descriptors.
# When set, ORACLE_HOST/PORT/SERVICE_NAME/SID are not required.
#
# Easy Connect Plus (two hosts):
#   ORACLE_CONNECTION_STRING=host1.example.com:1521,host2.example.com:1521/MYSERVICE
# TNS descriptor:
#   ORACLE_CONNECTION_STRING=(DESCRIPTION=(FAILOVER=on)(LOAD_BALANCE=on)(ADDRESS_LIST=(ADDRESS=(PROTOCOL=TCP)(HOST=host1)(PORT=1521))(ADDRESS=(PROTOCOL=TCP)(HOST=host2)(PORT=1521)))(CONNECT_DATA=(SERVICE_NAME=MYSERVICE)))
#
# ORACLE_CONNECTION_STRING=host1.example.com:1521,host2.example.com:1521/XEPDB1

# Option B: individual variables (single host)
# ORACLE_HOST=your-oracle-host
# ORACLE_PORT=1521
# ORACLE_USER=enterpriseglue
# ORACLE_PASSWORD=your-oracle-password
# ORACLE_SERVICE_NAME=XEPDB1
# ORACLE_SID=XE
# ORACLE_SCHEMA=MAIN
#
# Note: Oracle requires the oracledb npm package and Oracle Instant Client
# Install: pnpm add oracledb
# See: https://oracle.github.io/node-oracledb/INSTALL.html

# =============================================================================
# SQL Server Configuration (when DATABASE_TYPE=mssql)
# =============================================================================
# Works with: SQL Server (on-premises), Azure SQL Database, Azure SQL Managed Instance
#
# MSSQL_HOST=your-sqlserver-host
# MSSQL_PORT=1433
# MSSQL_USER=sa
# MSSQL_PASSWORD=your-sqlserver-password
# MSSQL_DATABASE=enterpriseglue
# MSSQL_SCHEMA=dbo
# MSSQL_ENCRYPT=true
# MSSQL_TRUST_SERVER_CERTIFICATE=false
#
# Azure SQL example:
#   MSSQL_HOST=your-server.database.windows.net
#   MSSQL_ENCRYPT=true (required for Azure)
#   MSSQL_TRUST_SERVER_CERTIFICATE=false
#
# Note: SQL Server requires the mssql npm package
# Install: pnpm add mssql

# =============================================================================
# Google Spanner Configuration (when DATABASE_TYPE=spanner)
# =============================================================================
# SPANNER_PROJECT_ID=your-gcp-project-id
# SPANNER_INSTANCE_ID=your-spanner-instance
# SPANNER_DATABASE_ID=enterpriseglue
#
# Note: Spanner requires @google-cloud/spanner npm package
# Install: pnpm add @google-cloud/spanner
# Set GOOGLE_APPLICATION_CREDENTIALS env var to service account JSON path
# For local emulator, set: SPANNER_EMULATOR_HOST=localhost:9010

# =============================================================================
# MySQL Configuration (when DATABASE_TYPE=mysql)
# =============================================================================
# Works with: MySQL, MariaDB, Amazon RDS for MySQL, Amazon Aurora MySQL
#
# MYSQL_HOST=your-mysql-host
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your-mysql-password
# MYSQL_DATABASE=enterpriseglue
#
# Note: MySQL requires the mysql2 npm package
# Install: pnpm add mysql2

# =============================================================================
# Authentication Configuration
# =============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=generate-a-secure-random-string-min-32-chars
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# Admin Bootstrap (First Run)
# Set these to seed the initial admin account on a fresh database.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-secure-password
# Set to true when you want the seeded admin (created by ADMIN_EMAIL on first run)
# to bypass email verification. Useful for self-hosted/local installs.
# ADMIN_EMAIL_VERIFICATION_EXEMPT=true

# =============================================================================
# Email Bootstrap (First Run)
# =============================================================================
# Optional: Set these to seed the default email configuration during deploy/startup.
# EMAIL_PROVIDER, EMAIL_API_KEY, EMAIL_FROM_NAME, EMAIL_FROM_EMAIL
# EMAIL_CONFIG_NAME, EMAIL_REPLY_TO, EMAIL_SMTP_HOST, EMAIL_SMTP_PORT,
# EMAIL_SMTP_SECURE, EMAIL_SMTP_USER
# Supported providers: resend, sendgrid, mailgun, mailjet, smtp
EMAIL_CONFIG_NAME="Default Email Configuration"
EMAIL_PROVIDER=resend
EMAIL_API_KEY=replace-with-provider-api-key
EMAIL_FROM_NAME=EnterpriseGlue
EMAIL_FROM_EMAIL=noreply@example.com
# EMAIL_REPLY_TO=support@example.com
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=true
# EMAIL_SMTP_USER=

# =============================================================================
# Camunda Configuration (Optional)
# =============================================================================
# CAMUNDA_BASE_URL=http://localhost:8080/engine-rest
# Engine endpoint policy. Production always requires HTTPS and an explicit host
# list before any direct-engine, sidecar, or OAuth token request is sent; the
# enforcement flag cannot disable that production policy. Wildcards must be
# narrow organizational suffixes. Private/address-literal/Docker-local hosts
# require an exact entry and the explicit private-host opt-in. This host policy
# is not DNS pinning; retain network egress controls.
# EG_ENGINE_ALLOWED_HOSTS=engine.customer.example,*.sidecars.customer.example
# EG_ENGINE_ALLOW_PRIVATE_HOSTS=false
# Set only for a controlled private-network HTTP migration; never use for public
# endpoints and do not treat it as a private-host or allowlist bypass.
# EG_ALLOW_INSECURE_ENGINE_HTTP=false
# EG_ENFORCE_ENGINE_ENDPOINT_POLICY=true
# Tenant application workflow. Keep direct for compatibility, or require a
# member request followed by tenant-administrator approval.
# ENTERPRISEGLUE_TENANT_APP_ACTIVATION_POLICY=direct
# CAMUNDA_USERNAME=demo
# CAMUNDA_PASSWORD=demo

# Git OAuth/API and external PII endpoint policy. Official public Git hosts are
# built in; custom production hosts require this reviewed allowlist. Private
# hosts require an exact entry and the separate opt-in. The transport rejects
# redirects, validates and pins DNS answers, and bounds time and response size.
# EG_ADMIN_INTEGRATION_ALLOWED_HOSTS=git.customer.example,pii.customer.example
# EG_ENFORCE_ADMIN_INTEGRATION_ENDPOINT_POLICY=true
# EG_ADMIN_INTEGRATION_ALLOW_PRIVATE_HOSTS=false

# =============================================================================
# Runtime Inventory Reconciliation (Optional)
# =============================================================================
# Disabled by default. Set a positive interval only for central/resource-aware
# engines that need scheduled process/decision inventory refreshes.
# RUNTIME_INVENTORY_RECONCILIATION_INTERVAL_MS=300000
# RUNTIME_INVENTORY_RECONCILIATION_TENANT_IDS=global
# RUNTIME_INVENTORY_RECONCILIATION_RUN_ON_START=false

# =============================================================================
# Configuration Bundle Stored Identity Replay (Optional)
# =============================================================================
# Continues bounded stored-snapshot pages after a config apply returns truncated.
# CONFIG_BUNDLE_IDENTITY_REPLAY_INTERVAL_MS=60000
# CONFIG_BUNDLE_IDENTITY_REPLAY_RUN_ON_START=false
# CONFIG_BUNDLE_IDENTITY_REPLAY_MAX_TASKS=10
# CONFIG_BUNDLE_IDENTITY_REPLAY_PAGE_LIMIT=500

# =============================================================================
# Authorization Configuration Bundle Bootstrap (Optional)
# =============================================================================
# Disabled by default. When enabled, the backend validates or applies a single
# JSON payload shaped as { "bundle": ..., "files": ... } after migrations and
# canonical authorization catalog seeding.
# EG_CONFIG_BUNDLE_PATH=/etc/enterpriseglue/config/bundle.json
# EG_CONFIG_BOOTSTRAP_MODE=validate
# EG_CONFIG_EXPECTED_SHA256=<64-character-sha256>
# EG_CONFIG_EXPECTED_TENANT_SCOPE=platform
# Production defaults EG_CONFIG_FAIL_CLOSED to true; set false only when a
# bootstrap failure must not stop startup.
# EG_CONFIG_FAIL_CLOSED=true
# EG_CONFIG_REQUIRE_SECRET_PREFLIGHT=false
# EG_CONFIG_MAX_BYTES=1048576
# EG_CONFIG_SECRET_PROVIDER=env
# File references require `file` plus an explicit allowed root. Docker secret
# references use `docker` and default to /run/secrets (or the optional root).
# EG_CONFIG_SECRET_FILE_ROOT=/var/run/secrets/enterpriseglue

# Signed tenant application eligibility is opt-in for self-hosted OSS and
# required for SaaS shards that offer plugins with entitlement.provider=plugin.
# EG_TENANT_APP_ELIGIBILITY_REQUIRED=false
# EG_TENANT_APP_ELIGIBILITY_JWKS_JSON=<single-line-public-es256-jwks-json>
# EG_TENANT_APP_ELIGIBILITY_ISSUER=https://control.example.com
# EG_TENANT_APP_ELIGIBILITY_AUDIENCE=enterpriseglue-shard
# EG_TENANT_APP_ELIGIBILITY_CLOCK_SKEW_SECONDS=60
# EG_TENANT_APP_ELIGIBILITY_MAX_LIFETIME_SECONDS=604800

# External identity providers
# Configure OIDC, SAML, LDAP, or Graph-enabled Microsoft providers in Platform
# Settings -> Identity Providers. Store credentials as secret references in the
# provider configuration; legacy MICROSOFT_* and GOOGLE_* environment variables
# are intentionally unsupported.
# Production outbound identity-provider traffic fails closed until every
# reviewed OIDC/SAML/LDAP host is allowlisted. Wildcards are permitted only for
# narrow organizational IdP subdomains (for example *.login.example.com);
# private and Docker-local hosts require an exact entry and
# the explicit private-network opt-in.
# EG_IDENTITY_PROVIDER_ALLOWED_HOSTS=login.microsoftonline.com,idp.example.com,directory.internal.example
# EG_ENFORCE_IDENTITY_PROVIDER_ENDPOINT_POLICY=true
# EG_IDENTITY_PROVIDER_ALLOW_PRIVATE_HOSTS=false
# EG_IDENTITY_FLOW_RATE_LIMIT_MAX=300
# Production uses a fail-safe 60-second scheduler cadence when omitted or set
# to zero. Non-production defaults to disabled unless explicitly configured.
# SSO_DIAGNOSTICS_INTERVAL_MS=60000
# EG_LDAP_RECONCILIATION_IDENTITY_LIMIT=10000
# EG_LDAP_RECONCILIATION_CONCURRENCY=4
# EG_LDAP_RECONCILIATION_GROUP_QUERY_LIMIT=10000
# EG_LDAP_RECONCILIATION_GROUP_RESULT_LIMIT=100000
# EG_LDAP_GROUP_SEARCH_QUERY_LIMIT=100
# EG_LDAP_GROUP_SEARCH_RESULT_LIMIT=5000


# =============================================================================
# Frontend & Environment
# =============================================================================
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Proxy Configuration
# Number of proxy hops, 'loopback', or specific subnet (e.g., '10.0.0.0/8')
# TRUST_PROXY=1

# =============================================================================
# Git Versioning Configuration
# =============================================================================
GIT_REPOS_PATH=./data/repos
GIT_DEFAULT_BRANCH=main

# Encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=generate-a-64-char-hex-string

# File Lock Configuration
LOCK_TIMEOUT_MS=1800000
LOCK_HEARTBEAT_INTERVAL_MS=30000

# Push Retry Configuration
PUSH_RETRY_ATTEMPTS=3
PUSH_RETRY_DELAY_MS=5000

# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
FROM node:24-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS build

WORKDIR /repo

# Install pnpm globally
RUN npm install -g pnpm@11.0.8

# Copy workspace manifests for pnpm install layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY backend/package.json backend/
COPY packages/shared/package.json packages/shared/
COPY packages/plugin-sdk/package.json packages/plugin-sdk/
COPY packages/plugin-runtime/package.json packages/plugin-runtime/
COPY packages/backend-host/package.json packages/backend-host/
COPY packages/enterprise-plugin-api/package.json packages/enterprise-plugin-api/
COPY packages/frontend-host/package.json packages/frontend-host/
COPY frontend/package.json frontend/
COPY patches patches

# BuildKit cache mount hydrates pnpm store across builds. `sharing=locked` serializes
# concurrent multi-platform builds safely. --frozen-lockfile ensures reproducible installs.
RUN --mount=type=cache,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --filter webmodeler-backend...

# Every required build dependency was installed from the frozen manifests.
# Copying the remaining workspace source must not trigger a second installation
# of unrelated packages when pnpm runs the package build scripts.
ENV pnpm_config_verify_deps_before_run=false

# Build OSS packages in dependency order. The backend entry point compiles the
# backend host into its output, while that host imports the generic plugin SDK
# and runtime at execution time.
COPY packages packages
RUN pnpm --filter plugin-sdk run build
# Build each dependency once in this already ordered graph. The standalone
# package build scripts intentionally rebuild their dependencies for callers.
RUN pnpm --filter shared run clean && pnpm --filter shared exec tsc && pnpm --filter shared run build:copy
RUN pnpm --filter plugin-runtime exec tsc -p tsconfig.json
RUN pnpm --filter backend-host exec tsc && pnpm --filter backend-host exec node scripts/rewrite-modules.mjs

COPY backend backend
RUN pnpm --filter webmodeler-backend exec tsc -p tsconfig.build.json \
    && pnpm --filter webmodeler-backend exec node scripts/resolve-dist-imports.mjs \
    && pnpm --filter webmodeler-backend exec node scripts/copy-build-assets.mjs

FROM node:24-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS deps

WORKDIR /repo

# Install pnpm globally
RUN npm install -g pnpm@11.0.8

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY backend/package.json backend/
COPY packages/shared/package.json packages/shared/
COPY packages/plugin-sdk/package.json packages/plugin-sdk/
COPY packages/plugin-runtime/package.json packages/plugin-runtime/
COPY packages/backend-host/package.json packages/backend-host/
COPY packages/enterprise-plugin-api/package.json packages/enterprise-plugin-api/
COPY packages/frontend-host/package.json packages/frontend-host/
COPY frontend/package.json frontend/
COPY patches patches

# The runtime dependency stage must not ship build/test dependencies. The build
# stage above retains the full tree; production modules still resolve from the
# same pnpm layout, with explicitly declared runtime dependencies preserved.
RUN --mount=type=cache,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --prod --frozen-lockfile --filter webmodeler-backend...

FROM cgr.dev/chainguard/node:latest-dev@sha256:cf779c59fe663d07b5c19e6f85a9286032c4ca097403a78e9b146626c06556ac AS runtime-root

FROM runtime-root AS runtime-base
USER root
RUN set -eux; \
    apk upgrade --no-cache; \
    apk add --no-cache --upgrade 'ca-certificates-bundle>=20260909-r3' 'libcurl-openssl4>=8.23.0-r0'; \
    runtime_tools="$(apk info | awk '/^(nodejs|npm|node-gyp|corepack)(-|$)/')"; \
    apk del --no-network ${runtime_tools}; \
    apk add --no-cache 'nodejs-24=24.21.0-r4' \
      'zlib>=1.3.2.1_rc20260921-r0' \
      'glibc-2.44>=2.44-r8' 'glibc-2.44-dev>=2.44-r8' \
      'glibc-2.44-locale-posix>=2.44-r8' 'ld-linux-2.44>=2.44-r8' 'libcrypt1-2.44>=2.44-r8'; \
    node -e 'if (process.versions.node.split(".")[0] !== "24") process.exit(1)'; \
    ! apk info -e node-gyp; \
    rm -rf /usr/lib/node_modules/npm /usr/bin/npm /usr/bin/npx
USER 65532

FROM runtime-base AS application

USER root
WORKDIR /app
ARG ENTERPRISEGLUE_HOST_VERSION=0.16.0
ENV NODE_ENV=production
ENV ENTERPRISEGLUE_HOST_VERSION=${ENTERPRISEGLUE_HOST_VERSION}

# The optional Compose/OpenShift config projection targets this directory. It
# must exist and be readable by the non-root Chainguard runtime user.
RUN mkdir -p /etc/enterpriseglue/config /var/run/secrets/enterpriseglue \
    && chown -R 65532:65532 /etc/enterpriseglue /var/run/secrets/enterpriseglue

COPY backend/package.json ./package.json

# The compiled backend runs from /app/dist/backend/src. With pnpm, package
# dependencies are symlinks from each workspace package's node_modules into the
# root .pnpm store, so copy that same layout under /app/dist for Node's module
# resolver.
COPY --from=deps /repo/node_modules ./dist/node_modules
COPY --from=deps /repo/backend/node_modules ./dist/backend/node_modules
COPY --from=deps /repo/packages/backend-host/node_modules ./dist/packages/backend-host/node_modules
# Workspace-linked shared modules resolve optional server peers from their own
# directory. Provide the backend host's production links at that same depth;
# published consumers use their package manager's peer-resolution capsule.
COPY --from=deps /repo/packages/backend-host/node_modules ./dist/packages/shared/node_modules
COPY --from=deps /repo/packages/shared/node_modules ./dist/packages/shared/node_modules

COPY --from=build /repo/backend/dist ./dist
# pnpm workspace links in dist/node_modules resolve these public package
# artifacts from dist/packages at runtime. Copy the built output rather than
# the source workspace so a production image stays self-contained.
COPY --from=build /repo/packages/plugin-sdk/package.json ./dist/packages/plugin-sdk/package.json
COPY --from=build /repo/packages/plugin-sdk/dist ./dist/packages/plugin-sdk/dist
COPY --from=deps /repo/packages/plugin-sdk/node_modules ./dist/packages/plugin-sdk/node_modules
COPY --from=build /repo/packages/plugin-runtime/package.json ./dist/packages/plugin-runtime/package.json
COPY --from=build /repo/packages/plugin-runtime/dist ./dist/packages/plugin-runtime/dist
COPY --from=deps /repo/packages/plugin-runtime/node_modules ./dist/packages/plugin-runtime/node_modules
# Keep the compiled shared package available beside its pnpm dependencies. The
# database adapters resolve production migrations from this dist tree; copying
# TypeScript sources elsewhere leaves the production image with an empty
# TypeORM migration inventory.
COPY --from=build /repo/packages/shared/package.json ./dist/packages/shared/package.json
COPY --from=build /repo/packages/shared/dist ./dist/packages/shared/dist

EXPOSE 8787

USER 65532

CMD ["dist/backend/src/server.js"]

# Optional Oracle flavor shares every compiled application artifact with the
# standard image. No native client is installed unless this target is selected.
FROM node:24-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS oracle-client-download
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/*
COPY backend/install-oracle-instant-client.sh /tmp/install-oracle-instant-client.sh
RUN sh /tmp/install-oracle-instant-client.sh "$TARGETARCH"

FROM application AS oracle
USER root
RUN apk add --no-cache libaio
COPY --from=oracle-client-download /opt/oracle /opt/oracle
COPY backend/oracle-runtime-notices.txt /app/ORACLE_RUNTIME_NOTICES
ENV LD_LIBRARY_PATH=/opt/oracle/instantclient_23_26
ENV UV_THREADPOOL_SIZE=32
USER 65532

# Preserve the historical default build target and dependency composition.
FROM application AS standard

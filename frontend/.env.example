# =============================================================================
# Voyager / EnterpriseGlue Frontend Configuration
# Copy this file to .env.local (or .env) and fill in your values
# =============================================================================

# Base URL for API calls.
#
# - In local development, the Vite dev server proxy can handle API requests
#   without needing an absolute base URL.
# - In production builds (or non-proxied setups), set this to your backend origin.
# - In Docker Compose, use root `.env.*` variable `API_BASE_URL`; compose maps it
#   to `VITE_API_BASE_URL` for frontend runtime.
VITE_API_BASE_URL=http://localhost:8787

# Runtime configuration of the API base URL (optional; "build once, deploy
# everywhere").
#
# When set, the app fetches this URL at startup and reads `apiBaseUrl` from the
# returned JSON, e.g. `{ "apiBaseUrl": "https://api.example.com" }`. This lets a
# single built artifact be promoted across environments (tst/acc/prd) without a
# rebuild — only the served config document differs. The value here is a
# root-relative *pointer*; deployments serve the environment-specific file at it.
#
# Leave unset to disable runtime config (behaviour is unchanged: VITE_API_BASE_URL
# then same-origin). Precedence when enabled: runtime config -> VITE_API_BASE_URL
# -> same-origin.
# VITE_RUNTIME_CONFIG_URL=/src/config/config.json
#
# When 'true', a missing/invalid runtime config (or one without a usable
# apiBaseUrl) becomes a fatal boot error instead of falling back. Default: false.
# VITE_RUNTIME_CONFIG_REQUIRED=false

# Feature flags (env-driven)
VITE_FEATURE_VOYAGER=true

VITE_FEATURE_STARBASE=true
VITE_FEATURE_MISSION_CONTROL=true
VITE_FEATURE_ENGINES=true

VITE_FEATURE_MC_PROCESSES=true
VITE_FEATURE_MC_BATCHES=true
VITE_FEATURE_MC_DECISIONS=true

VITE_FEATURE_SB_PROJECTS=true
VITE_FEATURE_SB_FILES=true

VITE_FEATURE_NOTIFICATIONS=true
VITE_FEATURE_USER_MENU=true

# Filled in by the versioned archive builder.
IMAGE_TAG=@RELEASE_TAG@
OPERATON_IMAGE=
# To start a customer sidecar in this project, set both values below.
# COMPOSE_PROFILES=sidecar
# OPERATON_SIDECAR_IMAGE=

# A browser-facing HTTPS URL is required for production OIDC or SAML.
FRONTEND_URL=http://localhost:8080
FRONTEND_HOST_PORT=8080
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# Match the exact host in the bundle. For OAuth, also include the token endpoint host.
EG_ENGINE_ALLOWED_HOSTS=operaton
# Only for a reviewed private HTTP endpoint. HTTPS is the default.
EG_ALLOW_INSECURE_ENGINE_HTTP=false
EG_IDENTITY_PROVIDER_ALLOWED_HOSTS=
# EG_IDENTITY_PROVIDER_ALLOW_PRIVATE_HOSTS=true
# EG_EXTRA_CA_FILE=/run/secrets/customer-root-ca.pem
# EG_OPERATON_BUNDLE=./enterpriseglue-config.json
# EG_OPERATON_POLICY_BUNDLE=./examples/peer-auth-policy.json

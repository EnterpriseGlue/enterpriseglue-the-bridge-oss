{
  "bundle": {
    "apiVersion": "enterpriseglue.ai/v1beta1",
    "kind": "EnterpriseGlueConfigBundle",
    "metadata": {
      "key": "platform.local-operaton",
      "owner": "customer-operations"
    },
    "tenantKey": "default",
    "mode": "additive",
    "login": {
      "localPassword": "enabled",
      "providerSelection": "chooser"
    },
    "imports": [
      "./engines.json",
      "./identity-providers.json",
      "./groups.json",
      "./identity-mappings.json",
      "./assignments.json"
    ]
  },
  "files": {
    "./engines.json": {
      "engines": [
        {
          "key": "engine.customer-operaton",
          "name": "Customer Operaton",
          "type": "operaton",
          "externalId": "customer-operaton",
          "baseUrl": "https://sidecar:8443/engine-rest",
          "connectionMode": "customer_sidecar",
          "auth": {
            "type": "bearer",
            "tokenRef": "docker://sidecar-token"
          },
          "tenancy": {
            "mode": "dedicated",
            "tenantRef": {
              "type": "default"
            }
          },
          "runtimeAccessScope": "engine_wide"
        }
      ]
    },
    "./identity-providers.json": {
      "identityProviders": [
        {
          "key": "identity.customer-oidc",
          "displayName": "Company SSO",
          "type": "oidc",
          "enabled": true,
          "authenticationMode": "direct",
          "allowVerifiedEmailLinking": false,
          "sync": {
            "triggers": [
              "login"
            ],
            "requiredForLogin": true,
            "incompleteEntitlements": "fail_closed",
            "connectorCapability": "claim_only",
            "scheduled": false
          },
          "oidc": {
            "issuerUrl": "https://idp.example.test/oidc",
            "clientId": "enterpriseglue",
            "clientSecretRef": "docker://oidc-client-secret",
            "callbackUrl": "https://enterpriseglue.example.test/api/auth/identity/callback",
            "scopes": [
              "openid",
              "profile",
              "email"
            ],
            "expectedAudience": "enterpriseglue"
          }
        }
      ]
    },
    "./groups.json": {
      "groups": [
        {
          "key": "group.operaton-platform-admins",
          "name": "EnterpriseGlue platform admins"
        },
        {
          "key": "group.operaton-operators",
          "name": "Operaton operators"
        }
      ]
    },
    "./identity-mappings.json": {
      "identityMappings": [
        {
          "key": "mapping.operaton-platform-admins",
          "providerKey": "identity.customer-oidc",
          "source": {
            "type": "role",
            "externalId": "EG.Platform.Admin",
            "operator": "exact"
          },
          "targetGroupKey": "group.operaton-platform-admins",
          "syncMode": "authoritative"
        },
        {
          "key": "mapping.operaton-operators",
          "providerKey": "identity.customer-oidc",
          "source": {
            "type": "role",
            "externalId": "EG.Operaton.Operate",
            "operator": "exact"
          },
          "targetGroupKey": "group.operaton-operators",
          "syncMode": "authoritative"
        }
      ]
    },
    "./assignments.json": {
      "assignments": [
        {
          "key": "assignment.oidc-platform-admin",
          "principal": {
            "type": "group",
            "key": "group.operaton-platform-admins"
          },
          "roleKey": "system.platform.admin",
          "scope": {
            "type": "platform"
          }
        },
        {
          "key": "assignment.oidc-operaton-operator",
          "principal": {
            "type": "group",
            "key": "group.operaton-operators"
          },
          "roleKey": "system.engine.operator",
          "scope": {
            "type": "engine",
            "engineKey": "engine.customer-operaton"
          }
        }
      ]
    }
  }
}

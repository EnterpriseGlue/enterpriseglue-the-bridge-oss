# Use 'production' for deployed environments. Outbound engine and identity
# endpoints fail closed until their reviewed hosts are allowlisted. HTTP engine
# traffic additionally requires the explicit temporary insecure override;
# direct SSO requires an HTTPS FRONTEND_URL and canonical callback paths.
NODE_ENV=production

# Outbound engine policy. Production enforcement cannot be disabled. Prefer
# exact hosts; use only narrow organizational wildcard suffixes. A private host
# needs an exact entry plus EG_ENGINE_ALLOW_PRIVATE_HOSTS=true. Allowlisting is
# not DNS pinning, so retain network egress controls. For a reviewed
# private-network HTTP migration only, also set EG_ALLOW_INSECURE_ENGINE_HTTP=true.
EG_ENGINE_ALLOWED_HOSTS=
EG_ENFORCE_ENGINE_ENDPOINT_POLICY=true
EG_ENGINE_ALLOW_PRIVATE_HOSTS=false
EG_ALLOW_INSECURE_ENGINE_HTTP=false

# Outbound identity-provider and pre-authentication policy. Private IdP/LDAP
# hosts require exact entries plus EG_IDENTITY_PROVIDER_ALLOW_PRIVATE_HOSTS=true.
EG_IDENTITY_PROVIDER_ALLOWED_HOSTS=
EG_ENFORCE_IDENTITY_PROVIDER_ENDPOINT_POLICY=true
EG_IDENTITY_PROVIDER_ALLOW_PRIVATE_HOSTS=false
EG_IDENTITY_FLOW_RATE_LIMIT_MAX=300
SSO_DIAGNOSTICS_INTERVAL_MS=60000
EG_LDAP_RECONCILIATION_IDENTITY_LIMIT=10000
EG_LDAP_RECONCILIATION_CONCURRENCY=4
EG_LDAP_RECONCILIATION_GROUP_QUERY_LIMIT=10000
EG_LDAP_RECONCILIATION_GROUP_RESULT_LIMIT=100000
EG_LDAP_GROUP_SEARCH_QUERY_LIMIT=100
EG_LDAP_GROUP_SEARCH_RESULT_LIMIT=5000

# Backend
# Backend remains internal-only in Docker production compose (no host port publish by default).
API_PORT=8787
FRONTEND_HOST_PORT=8080
# Keep FRONTEND_URL in sync with the public origin. Replace this HTTP localhost
# value with the external HTTPS origin before enabling direct OIDC or SAML.
FRONTEND_URL=http://localhost:8080

# Database Configuration
DATABASE_TYPE=postgres
POSTGRES_SCHEMA=main

# Postgres (used by both db container and backend)
POSTGRES_USER=enterpriseglue
POSTGRES_PASSWORD=change_me
POSTGRES_DB=enterpriseglue
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DATABASE=enterpriseglue
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=false

# Auth (set strong secrets in production)
# Generate JWT_SECRET: openssl rand -hex 32
JWT_SECRET=change_me_change_me_change_me_change_me
ADMIN_EMAIL=admin@enterpriseglue.ai
# Generate ADMIN_PASSWORD: openssl rand -base64 16
ADMIN_PASSWORD=change_me_change_me
# Set to true only if you want the seeded admin (created on first run)
# to bypass email verification.
# ADMIN_EMAIL_VERIFICATION_EXEMPT=false

# Email Bootstrap (First Run)
# Optional: Set these to seed the default email configuration during deploy/startup.
# EMAIL_PROVIDER, EMAIL_API_KEY, EMAIL_FROM_NAME, EMAIL_FROM_EMAIL
# EMAIL_CONFIG_NAME, EMAIL_REPLY_TO, EMAIL_SMTP_HOST, EMAIL_SMTP_PORT,
# EMAIL_SMTP_SECURE, EMAIL_SMTP_USER
# Supported providers: resend, sendgrid, mailgun, mailjet, smtp
EMAIL_CONFIG_NAME="Default Email Configuration"
EMAIL_PROVIDER=resend
EMAIL_API_KEY=replace-with-provider-api-key
EMAIL_FROM_NAME=EnterpriseGlue
EMAIL_FROM_EMAIL=noreply@example.com
# EMAIL_REPLY_TO=support@example.com
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=true
# EMAIL_SMTP_USER=

# Git + encryption (set strong key in production)
GIT_REPOS_PATH=./data/repos
GIT_DEFAULT_BRANCH=main
# Generate ENCRYPTION_KEY: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Frontend build
# Keep empty for same-origin API calls through Nginx reverse proxy (recommended).
# Set only when frontend must call a different API origin.
API_BASE_URL=

# Authorization configuration bundle bootstrap (optional; disabled by default).
# Use infra/docker/compose/docker-compose.config-bundle.yml to mount the JSON
# payload and a separate secret directory.
# EG_CONFIG_BUNDLE_PATH=/etc/enterpriseglue/config/bundle.json
# EG_CONFIG_BOOTSTRAP_MODE=validate
# EG_CONFIG_EXPECTED_SHA256=<64-character-sha256>
# EG_CONFIG_EXPECTED_TENANT_SCOPE=platform
# EG_CONFIG_FAIL_CLOSED=true
# EG_CONFIG_REQUIRE_SECRET_PREFLIGHT=false
# EG_CONFIG_MAX_BYTES=1048576
# EG_CONFIG_SECRET_PROVIDER=env
# EG_CONFIG_SECRET_FILE_ROOT=/var/run/secrets/enterpriseglue

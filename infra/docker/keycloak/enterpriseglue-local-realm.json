{
  "realm": "enterpriseglue-local",
  "enabled": true,
  "roles": {
    "realm": [{
      "name": "enterpriseglue.engine_operator",
      "description": "Synthetic Entra-compatible app role for local authorization rehearsals"
    }]
  },
  "clients": [{
    "clientId": "enterpriseglue-local",
    "enabled": true,
    "publicClient": true,
    "standardFlowEnabled": true,
    "attributes": {
      "pkce.code.challenge.method": "S256"
    },
    "redirectUris": [
      "http://localhost:5173/*",
      "https://localhost:5443/*",
      "https://localhost:15443/*"
    ],
    "webOrigins": [
      "http://localhost:5173",
      "https://localhost:5443",
      "https://localhost:15443"
    ],
    "protocolMappers": [{
      "name": "groups",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-group-membership-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "groups",
        "full.path": "false",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true"
      }
    }]
  }, {
    "clientId": "enterpriseglue-local-entra",
    "name": "EnterpriseGlue local Entra-compatible OIDC rehearsal",
    "enabled": true,
    "publicClient": true,
    "standardFlowEnabled": true,
    "attributes": {
      "pkce.code.challenge.method": "S256"
    },
    "redirectUris": [
      "http://localhost:5173/*",
      "https://localhost:5443/*",
      "https://localhost:15443/*"
    ],
    "webOrigins": [
      "http://localhost:5173",
      "https://localhost:5443",
      "https://localhost:15443"
    ],
    "protocolMappers": [{
      "name": "groups",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-group-membership-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "groups",
        "full.path": "false",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true"
      }
    }, {
      "name": "Entra object ID",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-attribute-mapper",
      "consentRequired": false,
      "config": {
        "user.attribute": "entra_oid",
        "claim.name": "oid",
        "jsonType.label": "String",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true"
      }
    }, {
      "name": "Entra tenant ID",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-attribute-mapper",
      "consentRequired": false,
      "config": {
        "user.attribute": "entra_tid",
        "claim.name": "tid",
        "jsonType.label": "String",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true"
      }
    }, {
      "name": "Entra app roles",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-realm-role-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "roles",
        "jsonType.label": "String",
        "multivalued": "true",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true"
      }
    }]
  }, {
    "clientId": "enterpriseglue-local-saml",
    "name": "EnterpriseGlue local SAML rehearsal",
    "protocol": "saml",
    "enabled": true,
    "publicClient": false,
    "redirectUris": [
      "https://localhost:5443/api/auth/providers/saml/callback",
      "https://localhost:15443/api/auth/providers/saml/callback"
    ],
    "attributes": {
      "saml.assertion.signature": "true",
      "saml.authnstatement": "true",
      "saml.client.signature": "false",
      "saml.force.post.binding": "true",
      "saml.server.signature": "true",
      "saml.signature.algorithm": "RSA_SHA256",
      "saml.assertion.nameid.format": "email"
    },
    "protocolMappers": [{
      "name": "email",
      "protocol": "saml",
      "protocolMapper": "saml-user-property-mapper",
      "consentRequired": false,
      "config": {
        "attribute.name": "email",
        "attribute.nameformat": "Basic",
        "friendly.name": "email",
        "user.attribute": "email"
      }
    }, {
      "name": "groups",
      "protocol": "saml",
      "protocolMapper": "saml-group-membership-mapper",
      "consentRequired": false,
      "config": {
        "attribute.name": "groups",
        "attribute.nameformat": "Basic",
        "full.path": "false",
        "single": "false"
      }
    }]
  }],
  "groups": [{
    "name": "operators"
  }, {
    "name": "group-id-operators"
  }],
  "users": [{
    "username": "oidc-operator",
    "enabled": true,
    "emailVerified": true,
    "email": "oidc-operator@localhost.test",
    "firstName": "OIDC",
    "lastName": "Operator",
    "credentials": [{"type": "password", "value": "local-oidc-operator", "temporary": false}],
    "realmRoles": ["offline_access"],
    "groups": ["/operators"]
  }, {
    "username": "entra-operator",
    "enabled": true,
    "emailVerified": true,
    "email": "entra-operator@localhost.test",
    "firstName": "Entra",
    "lastName": "Operator",
    "attributes": {
      "entra_oid": ["aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"],
      "entra_tid": ["11111111-2222-3333-4444-555555555555"]
    },
    "credentials": [{"type": "password", "value": "local-entra-operator", "temporary": false}],
    "realmRoles": ["enterpriseglue.engine_operator"],
    "groups": ["/group-id-operators"]
  }, {
    "username": "saml-operator",
    "enabled": true,
    "emailVerified": true,
    "email": "saml-operator@localhost.test",
    "firstName": "SAML",
    "lastName": "Operator",
    "credentials": [{"type": "password", "value": "local-saml-operator", "temporary": false}],
    "groups": ["/operators"]
  }]
}

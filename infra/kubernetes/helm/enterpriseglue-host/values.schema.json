{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["platform", "images", "frontend", "backend", "workers", "database", "serviceAccounts", "pluginAssets", "pluginManager", "ingress", "networkPolicy", "podDisruptionBudget", "topologySpread"],
  "properties": {
    "platform": { "enum": ["kubernetes", "openshift"] },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "frontend"],
      "properties": {
        "backend": { "$ref": "#/$defs/image" },
        "frontend": { "$ref": "#/$defs/image" }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 } } } },
    "rolloutRevision": { "type": "string", "maxLength": 128 },
    "apiConfigBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "configMapName", "configMapKey", "expectedSha256", "mode", "secret"],
      "properties": {
        "enabled": { "type": "boolean" },
        "configMapName": { "type": "string", "maxLength": 253, "pattern": "^(|[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*)$" },
        "configMapKey": { "type": "string", "maxLength": 253, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\.json$" },
        "expectedSha256": { "type": "string", "pattern": "^(|[a-f0-9]{64})$" },
        "mode": { "enum": ["validate", "apply"] },
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": { "type": "string", "maxLength": 253, "pattern": "^(|[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*)$" },
            "key": { "type": "string", "maxLength": 253, "pattern": "^(|[A-Za-z0-9][A-Za-z0-9_.-]*)$" }
          }
        }
      },
      "allOf": [{
        "if": { "properties": { "enabled": { "const": true } } },
        "then": {
          "properties": {
            "configMapName": { "minLength": 1 },
            "expectedSha256": { "minLength": 64 },
            "secret": { "properties": { "name": { "minLength": 1 }, "key": { "minLength": 1 } } }
          }
        }
      }]
    },
    "frontend": { "$ref": "#/$defs/workload" },
    "backend": { "$ref": "#/$defs/workload" },
    "workers": {
      "allOf": [{ "$ref": "#/$defs/workload" }],
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "configMapName", "applicationSecretName", "migrationSecretName", "preflightSecretName", "releaseEffectCohort", "migration", "preflight", "connectionProxy"],
      "properties": {
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["databaseType", "tenancyMode"],
          "properties": {
            "databaseType": { "type": "string", "enum": ["", "postgres", "oracle", "mysql", "mssql", "spanner"] },
            "tenancyMode": { "type": "string", "enum": ["", "single", "pooled"] }
          }
        },
        "configMapName": { "$ref": "#/$defs/name" },
        "applicationSecretName": { "$ref": "#/$defs/name" },
        "migrationSecretName": { "$ref": "#/$defs/name" },
        "preflightSecretName": { "$ref": "#/$defs/name" },
        "releaseEffectCohort": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "releaseId", "cohortEpoch", "inventoryVersion", "inventorySha256", "backoffLimit", "ttlSecondsAfterFinished"],
          "properties": {
            "enabled": { "type": "boolean" },
            "releaseId": { "type": "string", "maxLength": 256, "pattern": "^(|[A-Za-z0-9][A-Za-z0-9._:-]*)$" },
            "cohortEpoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "inventoryVersion": { "type": "string", "enum": ["", "release-effect-inventory.enterpriseglue.io/v1"] },
            "inventorySha256": { "type": "string", "pattern": "^(|[a-f0-9]{64})$" },
            "backoffLimit": { "type": "integer", "minimum": 0, "maximum": 10 },
            "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 }
          },
          "allOf": [{
            "if": { "properties": { "enabled": { "const": true } } },
            "then": {
              "properties": {
                "releaseId": { "minLength": 1 },
                "cohortEpoch": { "minimum": 1 },
                "inventoryVersion": { "minLength": 1 },
                "inventorySha256": { "minLength": 64 }
              }
            }
          }]
        },
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "backoffLimit", "ttlSecondsAfterFinished"],
          "properties": {
            "enabled": { "type": "boolean" },
            "backoffLimit": { "type": "integer", "minimum": 0, "maximum": 10 },
            "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
            "runtimeRole": { "type": "string", "pattern": "^(|[a-z_][a-z0-9_]{0,62})$" }
          }
        },
        "preflight": { "$ref": "#/$defs/job" },
        "connectionProxy": { "$ref": "#/$defs/connectionProxy" }
      }
    },
    "serviceAccounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "worker", "cohort", "migration", "preflight"],
      "properties": {
        "api": { "$ref": "#/$defs/serviceAccount" },
        "worker": { "$ref": "#/$defs/serviceAccount" },
        "cohort": { "$ref": "#/$defs/serviceAccount" },
        "migration": { "$ref": "#/$defs/serviceAccount" },
        "preflight": { "$ref": "#/$defs/serviceAccount" }
      }
    },
    "pluginAssets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "existingClaim", "mountPath"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "mountPath": { "type": "string", "pattern": "^/" }
      }
    },
    "pluginManager": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "imagePullPolicy", "serviceAccountName", "configurationSecret", "state", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "imagePullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "serviceAccountName": { "$ref": "#/$defs/name" },
        "configurationSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": { "name": { "$ref": "#/$defs/name" }, "key": { "type": "string", "minLength": 1 } }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingClaim", "size", "storageClassName"],
          "properties": { "existingClaim": { "type": "string" }, "size": { "type": "string" }, "storageClassName": { "type": "string" } }
        },
        "resources": { "type": "object" }
      }
    },
    "ingress": { "type": "object" },
    "networkPolicy": { "type": "object" },
    "podDisruptionBudget": { "type": "object" },
    "topologySpread": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" }
  },
  "$defs": {
    "name": { "type": "string", "minLength": 1, "maxLength": 253 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "workload": {
      "type": "object",
      "required": ["replicas", "resources", "autoscaling"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" },
        "service": { "type": "object", "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } } },
        "autoscaling": { "$ref": "#/$defs/autoscaling" }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "backoffLimit", "ttlSecondsAfterFinished"],
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0, "maximum": 10 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 }
      }
    },
    "connectionProxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "args", "port", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "pattern": "^(|\\S+@sha256:[a-f0-9]{64})$" },
        "args": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "resources": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations", "automountServiceAccountToken"],
      "properties": { "create": { "type": "boolean" }, "name": { "type": "string" }, "annotations": { "type": "object" }, "automountServiceAccountToken": { "type": "boolean" } }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterpriseglue.ai/schemas/deployment-evidence-matrix-v1.json",
  "title": "EnterpriseGlue access-governance deployment evidence matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceKind",
    "artifactRoot",
    "requiredCoverage",
    "lanes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "evidenceKind": {
      "const": "access-governance-deployment"
    },
    "artifactRoot": {
      "type": "string",
      "pattern": "^test/results/[a-z0-9/-]+$"
    },
    "requiredCoverage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "environmentClass",
          "gates",
          "prerequisites",
          "artifacts",
          "successCriteria",
          "covers",
          "timeoutMinutes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
          },
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 160
          },
          "environmentClass": {
            "enum": [
              "local_contract",
              "local_emulator",
              "local_container",
              "external_openshift"
            ]
          },
          "script": {
            "type": "string",
            "pattern": "^test:[a-z0-9:_-]+$"
          },
          "externalProcedure": {
            "type": "string",
            "pattern": "^docs/[a-zA-Z0-9_./-]+\\.md$"
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "pull_request",
                "local_release",
                "release",
                "external_acceptance"
              ]
            }
          },
          "prerequisites": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "successCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 8
            }
          },
          "covers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
            }
          },
          "timeoutMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "environmentClass": {
                  "const": "external_openshift"
                }
              }
            },
            "then": {
              "required": [
                "externalProcedure"
              ],
              "not": {
                "required": [
                  "script"
                ]
              }
            },
            "else": {
              "required": [
                "script"
              ],
              "not": {
                "required": [
                  "externalProcedure"
                ]
              }
            }
          }
        ]
      }
    }
  }
}

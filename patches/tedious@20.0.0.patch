new file mode 100644
index 0000000000000000000000000000000000000000..f645c41b93eb8105a8c7867739612708eee9f5f5
--- /dev/null
+++ b/lib/bounded-format.js
@@ -0,0 +1,33 @@
+'use strict';
+
+// EnterpriseGlue-owned diagnostic formatter for Tedious 20.0.0's fixed
+// literals only. Not a general sprintf implementation. No precision, dynamic
+// width, named lookup, callable argument, cache or attacker-sized padding.
+function sprintf(format, ...values) {
+  if (typeof format !== 'string' || format.length > 4096 || values.length > 64) {
+    throw new TypeError('Unsupported Tedious diagnostic format');
+  }
+  let output = '';
+  let argument = 0;
+  for (let offset = 0; offset < format.length;) {
+    if (format[offset] !== '%') {
+      output += format[offset++];
+      continue;
+    }
+    const token = /^%(?:0([1-8]))?([dsX%])/.exec(format.slice(offset));
+    if (!token || (token[1] && token[2] !== 'X') || (token[2] === '%' && token[1])) {
+      throw new TypeError('Unsupported Tedious diagnostic format');
+    }
+    offset += token[0].length;
+    if (token[2] === '%') { output += '%'; continue; }
+    if (argument >= values.length) throw new TypeError('Missing Tedious diagnostic argument');
+    const value = values[argument++];
+    if (token[2] === 's') output += String(value);
+    else if (token[2] === 'd') output += String(Number.parseInt(value, 10));
+    else output += (Number.parseInt(value, 10) >>> 0).toString(16).toUpperCase().padStart(Number(token[1] || 0), '0');
+  }
+  if (argument !== values.length) throw new TypeError('Unexpected Tedious diagnostic argument');
+  return output;
+}
+
+exports.sprintf = sprintf;

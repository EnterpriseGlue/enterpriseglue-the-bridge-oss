# Non-secret, loopback-only defaults for repository-local unit and contract lanes.
# The runner intentionally unsets inherited database configuration before loading
# this file so local-safe checks cannot accidentally target a self-hosted DB.
NODE_ENV=test
DATABASE_TYPE=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=postgres
POSTGRES_SCHEMA=main
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=false
JWT_SECRET=test-secret-test-secret-test-secret-1234567890
ADMIN_PASSWORD=test-admin-password
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
FRONTEND_URL=http://localhost:5173

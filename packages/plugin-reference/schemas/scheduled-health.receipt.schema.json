{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterpriseglue.io/plugins/reference-health/scheduled-health-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "deliveryId", "status", "reasonCode"],
  "properties": {
    "apiVersion": { "const": "scheduled-job-receipt.plugin.enterpriseglue.io/v1" },
    "deliveryId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "status": { "enum": ["accepted", "duplicate", "retryable_rejected", "permanent_rejected"] },
    "reasonCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 100 }
  }
}

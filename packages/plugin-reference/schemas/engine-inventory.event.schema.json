{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.enterpriseglue.io/events/engine-inventory-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["engineRef", "product", "version", "observedAtBucket"],
  "properties": {
    "engineRef": { "type": "string", "minLength": 1, "maxLength": 256 },
    "product": { "enum": ["operaton", "camunda7"] },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "maxLength": 200 },
    "observedAtBucket": { "type": "string", "format": "date-time" }
  }
}

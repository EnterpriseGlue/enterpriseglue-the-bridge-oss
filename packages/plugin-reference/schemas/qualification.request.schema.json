{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterpriseglue.io/plugins/reference-health/qualification-request-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["runRef"],
  "properties": {
    "runRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    }
  }
}
